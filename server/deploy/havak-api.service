# Havak API under systemd. This is the live unit, verbatim.
# Installed at /etc/systemd/system/havak-api.service.
#
# Before this existed the API was started by hand in an SSH session, so it died
# whenever that session closed — the pilot API was up only while someone was
# logged in. Restart=always plus `systemctl enable` means it now survives both
# a logout and a reboot.

[Unit]
Description=Havak API (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/root/Dilijan-Business-Hackathon

# 127.0.0.1, NOT 0.0.0.0. nginx on this host is the only thing that may reach
# uvicorn. Binding publicly is what previously exposed the API on port 8000 in
# cleartext, where every POST /auth/login carried a password in the clear.
# Env comes from server/.env, loaded by server/__init__.py relative to
# WorkingDirectory — which is why WorkingDirectory must stay the repo root.
ExecStart=/root/Dilijan-Business-Hackathon/server/.venv/bin/uvicorn \
    server.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
