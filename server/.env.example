# Havak API — copy to .env on the server and fill in. NEVER commit the real .env.
#
# Everything here is a secret except ALLOWED_ORIGINS. These values live on your
# server only; nothing in this file ever reaches the browser.

# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled connection (port 6543) if your host opens many short-lived
# connections; use 5432 for a normal long-running process.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.jrixcgfldkhcftkodfov.supabase.co:5432/postgres

# Signs session tokens. Generate a fresh one and keep it stable — changing it
# logs every user out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Supabase → Project Settings → API. The SERVICE key, not the publishable one:
# minting signed upload URLs needs to bypass RLS, which is exactly why this key
# may never appear in the frontend.
SUPABASE_URL=https://jrixcgfldkhcftkodfov.supabase.co
SUPABASE_SERVICE_KEY=

# Which origins may call this API. Comma-separated, no trailing slash.
# The published site's origin MUST be here or the browser blocks every request.
ALLOWED_ORIGINS=https://your-published-site.example,http://localhost:20220

# Optional
DB_POOL_MAX=10
TOKEN_DAYS=60
MEDIA_BUCKET=report-media
AVATAR_BUCKET=avatars
READ_URL_TTL=21600
