# Havak API — copy to .env on the server and fill in. NEVER commit the real .env.
#
# Everything here is a secret except ALLOWED_ORIGINS. These values live on your
# server only; nothing in this file ever reaches the browser.

# Supabase → Connect → Session pooler → URI.
#
# Use the POOLER host, not db.jrixcgfldkhcftkodfov.supabase.co. The direct host
# publishes an IPv6 address and no IPv4 one, so on an IPv4-only server it fails
# at DNS with "Temporary failure in name resolution" before Postgres is ever
# reached. The pooler has IPv4.
#
# Note the username: postgres.<project-ref>, NOT plain postgres. The pooler
# needs the ref to know which project this is.
#
# Session pooler is port 5432 and behaves like a direct connection — right for a
# long-running uvicorn process. The transaction pooler on 6543 also works
# (db.py sets statement_cache_size=0 for it) if your host cycles connections.
#
# Percent-encode the password if it contains @ : / ? or #.
DATABASE_URL=postgresql://postgres.jrixcgfldkhcftkodfov:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Signs session tokens. Generate a fresh one and keep it stable — changing it
# logs every user out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Supabase → Project Settings → API. The SERVICE key, not the publishable one:
# minting signed upload URLs needs to bypass RLS, which is exactly why this key
# may never appear in the frontend.
SUPABASE_URL=https://jrixcgfldkhcftkodfov.supabase.co
SUPABASE_SERVICE_KEY=

# Which origins may call this API. Comma-separated, no trailing slash.
# The published site's origin MUST be here or the browser blocks every request.
ALLOWED_ORIGINS=https://your-published-site.example,http://localhost:20220

# Optional
DB_POOL_MAX=10
TOKEN_DAYS=60
MEDIA_BUCKET=report-media
AVATAR_BUCKET=avatars
READ_URL_TTL=21600

# ---------------------------------------------------------------------------
# Email: confirming addresses and resetting passwords
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=log (the default) sends nothing. It writes the whole message,
# link included, to the server log, so both flows work and are testable with no
# mail account at all:
#
#   journalctl -u havak-api -n 200 | grep -A12 'email/log'
#
# Switch to smtp and fill in the four SMTP_ lines to deliver for real. Nothing in
# the code changes.
EMAIL_BACKEND=log

# Do not try to deliver straight from the VPS with its own Postfix. A fresh
# server address with no SPF, no DKIM and no reverse DNS gets filed as spam by
# Gmail no matter what the message says. Relay through something with a
# reputation. Two that work:
#
#   Gmail, with an App Password (Google account needs 2FA on):
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#     SMTP_USER=you@gmail.com   SMTP_PASSWORD=<16-char app password>
#   Google shows that password as four spaced groups; paste it either way,
#   the spaces are stripped before use.
#     MAIL_FROM=Havak <you@gmail.com>        <-- must be the same address
#   500 messages a day, works immediately, needs no domain. Right for a pilot.
#
#   Resend (or Postmark, SendGrid, Mailgun — all the same shape):
#     SMTP_HOST=smtp.resend.com SMTP_PORT=587
#     SMTP_USER=resend          SMTP_PASSWORD=<api key>
#     MAIL_FROM=Havak <no-reply@yourdomain>  <-- domain must be verified there
#   Better deliverability and proper bounce handling, but needs a domain you own.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Havak <no-reply@havak.am>

# Where the emailed links point: the published app, not this API. If the site
# moves, this moves with it or every link 404s.
APP_URL=https://fedorshoshin.github.io/Dilijan-Business-Hackathon/app.html

# How long links stay good. Reset is deliberately short: it is a key to the
# account sitting in an inbox.
VERIFY_TOKEN_HOURS=48
RESET_TOKEN_HOURS=1
