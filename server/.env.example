# Havak API — copy to .env on the server and fill in. NEVER commit the real .env.
#
# Everything here is a secret except ALLOWED_ORIGINS. These values live on your
# server only; nothing in this file ever reaches the browser.

# Supabase → Connect → Session pooler → URI.
#
# Use the POOLER host, not db.jrixcgfldkhcftkodfov.supabase.co. The direct host
# publishes an IPv6 address and no IPv4 one, so on an IPv4-only server it fails
# at DNS with "Temporary failure in name resolution" before Postgres is ever
# reached. The pooler has IPv4.
#
# Note the username: postgres.<project-ref>, NOT plain postgres. The pooler
# needs the ref to know which project this is.
#
# Session pooler is port 5432 and behaves like a direct connection — right for a
# long-running uvicorn process. The transaction pooler on 6543 also works
# (db.py sets statement_cache_size=0 for it) if your host cycles connections.
#
# Percent-encode the password if it contains @ : / ? or #.
DATABASE_URL=postgresql://postgres.jrixcgfldkhcftkodfov:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Signs session tokens. Generate a fresh one and keep it stable — changing it
# logs every user out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Supabase → Project Settings → API. The SERVICE key, not the publishable one:
# minting signed upload URLs needs to bypass RLS, which is exactly why this key
# may never appear in the frontend.
SUPABASE_URL=https://jrixcgfldkhcftkodfov.supabase.co
SUPABASE_SERVICE_KEY=

# Which origins may call this API. Comma-separated, no trailing slash.
# The published site's origin MUST be here or the browser blocks every request.
ALLOWED_ORIGINS=https://your-published-site.example,http://localhost:20220

# Optional
DB_POOL_MAX=10
TOKEN_DAYS=60
MEDIA_BUCKET=report-media
AVATAR_BUCKET=avatars
READ_URL_TTL=21600
