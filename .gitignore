node_modules/
package-lock.json
package.json

# Server secrets. .env.example is committed; a real .env never is — it holds the
# database password, the JWT signing key and the Supabase service key.
.env
server/.env
# Backups and variants hold the same secrets, and are just as dangerous
# committed. server/.env.save on the VPS was one `git add .` from being public.
.env.*
server/.env.*
!server/.env.example
__pycache__/
*.pyc
.venv/
